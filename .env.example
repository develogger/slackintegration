# A separate secret for this bridge.
# Do NOT reuse your Slack token here.
BRIDGE_TOKEN=replace-with-a-long-random-secret

# Slack bot token. Keep this ONLY in Vercel Environment Variables.
SLACK_BOT_TOKEN=xoxb-replace-me

# Default Slack channel ID, e.g. C0123456789
SLACK_DEFAULT_CHANNEL=C0123456789

# Optional extra channel IDs, comma-separated.
SLACK_ALLOWED_CHANNELS=C0123456789
